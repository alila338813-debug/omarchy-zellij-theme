#!/bin/bash

THEME_NAME="$1"
COLORS_FILE="$2"

if [[ -z "$THEME_NAME" ]] || [[ ! -f "$COLORS_FILE" ]]; then
  exit 0
fi

hex_to_rgb() {
  local hex="${1#\#}"
  printf "%d;%d;%d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

# Omarchy 4.5 colors.toml is semantic (red/green/..., no color1..color6).
# Ask Omarchy's resolver first so both semantic and legacy themes work, then
# fall back to reading the file directly for an older or partial install.
declare -A THEME_COLORS=()
if command -v omarchy-theme-color >/dev/null 2>&1; then
  while IFS=$'\t' read -r key value; do
    [[ -n $key ]] && THEME_COLORS[$key]="$value"
  done < <(omarchy-theme-color --file "$COLORS_FILE" --all 2>/dev/null)
fi

file_color() {
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*[\"']\{0,1\}\([^\"'[:space:]#]*\).*/\1/p" "$COLORS_FILE" | head -n 1
}

get_color() {
  local value="${THEME_COLORS[$1]:-}"
  [[ -n $value ]] || value=$(file_color "$1")
  printf '%s' "$value"
}

resolve_color() {
  local value
  value=$(get_color "$1")
  [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || value=$(get_color "$2")
  [[ $value =~ ^#[0-9A-Fa-f]{6}$ ]] || value="#ffffff"
  printf '%s' "$value"
}

# 4.5 stores the slug in theme.name; show the same title case as
# `omarchy theme current` (legacy display names pass through unchanged).
THEME_NAME=$(printf '%s' "$THEME_NAME" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g')

ACCENT=$(resolve_color accent color4)
COLORS=(
  "$(hex_to_rgb "$(resolve_color red color1)")"
  "$(hex_to_rgb "$(resolve_color green color2)")"
  "$(hex_to_rgb "$(resolve_color yellow color3)")"
  "$(hex_to_rgb "$(resolve_color blue color4)")"
  "$(hex_to_rgb "$(resolve_color magenta color5)")"
  "$(hex_to_rgb "$(resolve_color cyan color6)")"
)
A=$(hex_to_rgb "$ACCENT")

TERM_COLS=$(tput cols)
TERM_LINES=$(tput lines)
START_ROW=$(( (TERM_LINES - 3) / 2 ))

move_to() {
  printf '\033[%d;%dH' "$1" "$2"
}

clear
printf '\033[?25l'

LABEL="◆ $THEME_NAME"
LABEL_LEN=$(( ${#THEME_NAME} + 2 ))
LABEL_COL=$(( (TERM_COLS - LABEL_LEN) / 2 ))

move_to "$START_ROW" "$LABEL_COL"
printf '\033[1;38;2;%sm%s\033[0m' "$A" "$LABEL"

COLORS_WIDTH=$(( ${#COLORS[@]} * 4 ))
COLORS_COL=$(( (TERM_COLS - COLORS_WIDTH) / 2 ))

move_to $((START_ROW + 2)) "$COLORS_COL"
for c in "${COLORS[@]}"; do
  printf '\033[48;2;%sm    \033[0m' "$c"
  sleep 0.03
done

sleep 0.75
printf '\033[?25h'
