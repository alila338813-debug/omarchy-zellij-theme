#!/bin/bash

GENERATED_THEME="$HOME/.local/state/omarchy/current/theme/zellij.kdl"
ZELLIJ_CONFIG="$HOME/.config/zellij/config.kdl"
START_MARKER="// --- omarchy-zellij-theme (start) ---"
END_MARKER="// --- omarchy-zellij-theme (end) ---"

if [[ ! -f "$GENERATED_THEME" ]] || [[ ! -f "$ZELLIJ_CONFIG" ]]; then
  exit 0
fi

# Omarchy 4.5 runs hooks of superseded switches too (its docs: "its hook still
# runs"). The hook gets the theme it was queued for as $1; skip when a newer
# switch has already replaced it, so no stale notification or rewrite lands.
CURRENT_THEME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null | tr -d '\n')
if [[ -n "${1:-}" && -n "$CURRENT_THEME" && "$1" != "$CURRENT_THEME" ]]; then
  exit 0
fi

# Convert "R,G,B" to "R G B" for Zellij
THEME_BLOCK=$(sed 's/\([0-9]\{1,3\}\),\([0-9]\{1,3\}\),\([0-9]\{1,3\}\)/\1 \2 \3/g' "$GENERATED_THEME")

# A config kept in a dotfiles repo is usually a symlink. Rewrite the file it
# points at, so the rewrite below never replaces the link with a plain file.
CONFIG_PATH=$(readlink -f "$ZELLIJ_CONFIG" 2>/dev/null) || CONFIG_PATH="$ZELLIJ_CONFIG"
CONFIG_DIR=$(dirname "$CONFIG_PATH")

# Build the new config next to the old one and swap it in whole. Zellij watches
# this file and reloads on every change; a config truncated first and written
# afterwards can be read half-written, and a parse error there leaves the
# running sessions on the previous theme until something rewrites the file.
WORK=$(mktemp "$CONFIG_DIR/.config.kdl.XXXXXX" 2>/dev/null)
if [[ -z "$WORK" ]]; then
  echo "omarchy-zellij-theme: cannot write next to $CONFIG_PATH" >&2
  exit 1
fi

render_config() {
  local target="$1" clean

  # Remove previous theme block if present. Command substitution drops the
  # newlines (and blank lines) left behind, so re-running on an unchanged theme
  # produces byte-identical output instead of growing the file each switch.
  clean=$(sed "\%${START_MARKER}%,\%${END_MARKER}%d" "$CONFIG_PATH")
  printf '%s\n' "$clean" >"$target"

  # Select our theme on every run. `zellij options`, a zellij upgrade and
  # Omarchy's own config templates can regenerate config.kdl and drop the
  # `theme` node (or re-enable `theme_dark`/`theme_light`, which override it).
  # Zellij then silently falls back to its built-in theme: the UI never follows
  # Omarchy again, while the rest of the desktop (terminals included) does.
  sed -i -E 's#^([[:space:]]*)(theme|theme_dark|theme_light)([[:space:]]+")#\1// \2\3#' "$target"
  if grep -q '^// *theme ' "$target"; then
    sed -i '0,/^\/\/ *theme /{s|^// *theme .*|theme "omarchy"|}' "$target"
  else
    printf 'theme "omarchy"\n' >>"$target"
  fi

  # Append new theme block
  printf '\n%s\n%s\n%s\n' "$START_MARKER" "$THEME_BLOCK" "$END_MARKER" >>"$target"
}

# A config zellij cannot parse loses every setting until someone fixes the
# file, so never trade a working config for a broken one.
render_config "$WORK"
if ! ZELLIJ_CONFIG_FILE="$WORK" zellij setup --check >/dev/null 2>&1; then
  echo "omarchy-zellij-theme: refusing to write an invalid config, kept $CONFIG_PATH" >&2
  rm -f "$WORK"
  exit 1
fi

# Same bytes (a refresh, or a theme that maps to the same colors): leave the
# file alone, so zellij is not asked to reload for nothing.
if cmp -s "$WORK" "$CONFIG_PATH"; then
  rm -f "$WORK"
else
  chmod --reference="$CONFIG_PATH" "$WORK" 2>/dev/null || chmod 644 "$WORK"
  mv -f "$WORK" "$CONFIG_PATH"
fi

# --- Theme change notification ---
THEME_NAME="$CURRENT_THEME"
COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
NOTIFY_SCRIPT="$SCRIPT_DIR/theme-notify"

if [[ -z "$THEME_NAME" ]] || [[ ! -f "$COLORS_FILE" ]] || [[ ! -f "$NOTIFY_SCRIPT" ]]; then
  exit 0
fi

ACTIVE_SESSIONS=$(zellij list-sessions 2>/dev/null | grep -v "EXITED" | awk '{print $1}' | sed 's/\x1b\[[0-9;]*m//g')

if [[ -n "$ACTIVE_SESSIONS" ]]; then
  while IFS= read -r session; do
    ZELLIJ_SESSION_NAME="$session" zellij action new-pane \
      --floating \
      --close-on-exit \
      --borderless true \
      --width "100%" \
      --height "100%" \
      --x "0" \
      --y "0" \
      -- "$NOTIFY_SCRIPT" "$THEME_NAME" "$COLORS_FILE" &
  done <<< "$ACTIVE_SESSIONS"
fi
